# Copy to .env.local (never .env) and fill in. Vite and the db:* scripts read .env.local.
# Supabase project URL (Project Settings > API), e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# Publishable (anon) key. Safe for the browser; row access is enforced by RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Same values for server-side rendering and server functions.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Postgres connection for `npm run db:push` and `npm run db:types` only; the app never reads it.
# Supabase dashboard > Connect > Session pooler, with your database password filled in.
SUPABASE_DB_URL=
# Optional. Only for server-only admin code; never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
